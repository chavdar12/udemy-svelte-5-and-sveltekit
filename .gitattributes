# Normalize line endings to LF in the repo, whatever the OS.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files - never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated - collapse in diffs and keep out of language stats.
package-lock.json linguist-generated=true -diff
