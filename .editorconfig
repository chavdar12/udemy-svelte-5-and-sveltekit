# Editor defaults (https://editorconfig.org). Generated projects with their own .editorconfig keep theirs.
# Indents match the formatters CI runs: 2 spaces by default (prettier), 4 where the language uses 4.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{js,mjs,cjs,jsx,ts,tsx,css,scss,html}]
indent_size = 4

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
